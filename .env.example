# For local `docker compose up` only (see docker-compose.yml) - credentials
# for the local Postgres container. Copy to .env and fill in; .env is
# gitignored, never commit it.
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Everything below this line is also what Render needs, set directly in
# its dashboard (Environment tab) rather than from this file - Render never
# reads .env from the repo. ---

# HS256 requires at least 256 bits (32+ characters). Generate one with:
#   openssl rand -base64 32
JWT_SECRET_KEY=change-me

# From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# The deployed frontend's origin (no trailing slash). Used for CORS and the
# WebSocket handshake's allowed origin.
APP_FRONTEND_ORIGIN=https://your-frontend.vercel.app

# On Render, replace these three with your Neon connection details instead
# of DB_USERNAME/DB_PASSWORD above (Neon requires SSL - sslmode=require):
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-user>
# SPRING_DATASOURCE_PASSWORD=<neon-password>

# On Render only - required. Render injects its own PORT (default 10000)
# and expects the app to bind to it; Spring only auto-binds the env var
# name SERVER_PORT, not a bare PORT, so this has to be set explicitly.
# SERVER_PORT=10000
