# Copy to .env and fill in real values. .env is gitignored - never commit it.

DB_USERNAME=postgres
DB_PASSWORD=change-me

# HS256 requires at least 256 bits (32+ characters). Generate one with:
#   openssl rand -base64 32
JWT_SECRET_KEY=change-me

# From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# The deployed frontend's origin (no trailing slash). Used for CORS and the
# WebSocket handshake's allowed origin.
APP_FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Only needed for docker-compose.prod.yml (Caddy/HTTPS). Point this domain's
# DNS A record at the VM's IP before starting - Caddy gets a Let's Encrypt
# certificate for it automatically. Auth cookies are Secure-only, so the
# backend does not work over plain HTTP without this.
DOMAIN=api.yourdomain.com
